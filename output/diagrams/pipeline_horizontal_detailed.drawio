<mxfile><diagram id="d1" name="d1"><mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="🏗️  AI-Enabled Exoplanet Detection Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#16213E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450.0" y="14" width="700" height="40" as="geometry"/></mxCell><mxCell id="n12" value="TESS Light Curve  →  Confidence-Scored Report  ·  Every Stage Inspectable" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5A6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="450.0" y="50" width="700" height="22" as="geometry"/></mxCell><mxCell id="n13" value="&lt;span style='font-size:26px'&gt;📡&lt;/span&gt;&amp;nbsp;&lt;b style='font-size:15px'&gt;Data Ingestion&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;  • MAST Archive (lightkurve)&lt;br&gt;  • Curated ISRO Dataset&lt;br&gt;  • Synthetic Generator&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C63E0;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="100" width="370.0" height="155" as="geometry"/></mxCell><mxCell id="n14" value="&lt;span style='font-size:13px;color:#4C63E0'&gt;&lt;b&gt;→ DataFrame(time, flux, err)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#4C63E0;strokeWidth=2;fontSize=15;fontColor=#4C63E0;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="265" width="370.0" height="48" as="geometry"/></mxCell><mxCell id="n15" value="&lt;span style='font-size:26px'&gt;🧹&lt;/span&gt;&amp;nbsp;&lt;b style='font-size:15px'&gt;Preprocessing&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;  • Sigma Clip (5σ outliers)&lt;br&gt;  • S-G Detrend (0.5d)&lt;br&gt;  • Flux Normalization&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420.0" y="100" width="370.0" height="155" as="geometry"/></mxCell><mxCell id="n16" value="&lt;span style='font-size:13px;color:#FF6600'&gt;&lt;b&gt;→ Detrended Flux&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#FF6600;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420.0" y="265" width="370.0" height="48" as="geometry"/></mxCell><mxCell id="n17" value="&lt;span style='font-size:26px'&gt;🔍&lt;/span&gt;&amp;nbsp;&lt;b style='font-size:15px'&gt;BLS Period Search&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;  • Box Least Squares&lt;br&gt;  • 5000 periods × 20 durations&lt;br&gt;  • Peak SNR selection&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="810.0" y="100" width="370.0" height="155" as="geometry"/></mxCell><mxCell id="n18" value="&lt;span style='font-size:13px;color:#FF6600'&gt;&lt;b&gt;→ {period, depth, t0, SNR}&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#FF6600;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="810.0" y="265" width="370.0" height="48" as="geometry"/></mxCell><mxCell id="n19" value="&lt;span style='font-size:26px'&gt;⏱&lt;/span&gt;&amp;nbsp;&lt;b style='font-size:15px'&gt;Phase Folding&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;  • Fold on best period&lt;br&gt;  • Stack all transits&lt;br&gt;  • 30-bin binned curve&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1200.0" y="100" width="370.0" height="155" as="geometry"/></mxCell><mxCell id="n20" value="&lt;span style='font-size:13px;color:#FF6600'&gt;&lt;b&gt;→ Phase-Folded LC&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#FF6600;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1200.0" y="265" width="370.0" height="48" as="geometry"/></mxCell><mxCell id="n21" value="&lt;span style='font-size:26px'&gt;📊&lt;/span&gt;&amp;nbsp;&lt;b style='font-size:15px'&gt;Feature Engineering&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;  • Transit shape (slope, V/U)&lt;br&gt;  • Noise stats (skew, entropy)&lt;br&gt;  • Depth consistency&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="373" width="370.0" height="155" as="geometry"/></mxCell><mxCell id="n22" value="&lt;span style='font-size:13px;color:#9673A6'&gt;&lt;b&gt;→ 17-dim Feature Vector&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#9673A6;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="538" width="370.0" height="48" as="geometry"/></mxCell><mxCell id="n23" value="&lt;span style='font-size:26px'&gt;🤖&lt;/span&gt;&amp;nbsp;&lt;b style='font-size:15px'&gt;Classification&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;  • Odd-even + secondary + shape&lt;br&gt;  • Random Forest (4 classes)&lt;br&gt;  • Mamba SSM (Phase 2)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420.0" y="373" width="370.0" height="155" as="geometry"/></mxCell><mxCell id="n24" value="&lt;span style='font-size:13px;color:#9673A6'&gt;&lt;b&gt;→ Label + Flags&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#9673A6;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420.0" y="538" width="370.0" height="48" as="geometry"/></mxCell><mxCell id="n25" value="&lt;span style='font-size:26px'&gt;✅&lt;/span&gt;&amp;nbsp;&lt;b style='font-size:15px'&gt;Validation &amp;amp; Scoring&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;  • Physical plausibility checks&lt;br&gt;  • Weighted 0-1 