<mxfile><diagram id="d1" name="d1"><mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="🏗️  AI-Enabled Exoplanet Transit Detection — System Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#16213E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350.0" y="16" width="600" height="42" as="geometry"/></mxCell><mxCell id="n12" value="7-layer pipeline · every stage inspectable · no black box" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#5A6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350.0" y="56" width="600" height="24" as="geometry"/></mxCell><mxCell id="n13" value="&lt;span style='font-size:28px'&gt;📡&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:11px'&gt;LAYER 1  DATA INGESTION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#4C63E0;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="200" height="78" as="geometry"/></mxCell><mxCell id="n14" value="&lt;span style='font-size:18px'&gt;📡&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style='font-size:14px'&gt;TESS FITS  (lightkurve / MAST)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Curated ISRO Dataset  (labels)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Synthetic Generator  (src/data_io.py)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C63E0;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="274" y="90" width="940" height="78" as="geometry"/></mxCell><mxCell id="n15" value="&lt;span style='font-size:28px'&gt;🧹&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:11px'&gt;LAYER 2  PREPROCESSING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="200" height="78" as="geometry"/></mxCell><mxCell id="n16" value="&lt;span style='font-size:18px'&gt;🧹&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style='font-size:14px'&gt;Sigma Clip  (5σ outlier removal)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Savitzky-Golay Detrend  (0.5-day)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Flux Normalization  →  relative flux&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="274" y="180" width="940" height="78" as="geometry"/></mxCell><mxCell id="n17" style="edgeStyle=none;rounded=0;html=1;strokeColor=#FF6600;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;span style='font-size:28px'&gt;🔍&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:11px'&gt;LAYER 3  SIGNAL DETECTION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="200" height="78" as="geometry"/></mxCell><mxCell id="n19" value="&lt;span style='font-size:18px'&gt;🔍&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style='font-size:14px'&gt;BLS Periodogram  (5000 periods, 0.5–15 d)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Peak Selection  (max SNR above noise floor)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Phase Folding  (stack all transits)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="274" y="270" width="940" height="78" as="geometry"/></mxCell><mxCell id="n20" style="edgeStyle=none;rounded=0;html=1;strokeColor=#FF6600;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n15" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="&lt;span style='font-size:28px'&gt;📊&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:11px'&gt;LAYER 4  FEATURE ENGINEERING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="200" height="78" as="geometry"/></mxCell><mxCell id="n22" value="&lt;span style='font-size:18px'&gt;📊&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style='font-size:14px'&gt;Transit Shape  (ingress/egress slope, V/U ratio)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Noise Stats  (skew, kurtosis, entropy, red-noise)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Depth Consistency  (per-transit spread, variation)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="274" y="360" width="940" height="78" as="geometry"/></mxCell><mxCell id="n23" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9673A6;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n18" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="&lt;span style='font-size:28px'&gt;🤖&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:11px'&gt;LAYER 5  CLASSIFICATION ENGINE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="200" height="78" as="geometry"/></mxCell><mxCell id="n25" value="&lt;span style='font-size:18px'&gt;🤖&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style='font-size:14px'&gt;Classical Vetting  (odd-even, secondary, shape)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Random Forest  (300 trees, 4 classes, running now)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Mamba SSM  (bidirectional, 6 classes, Phase 2)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="274" y="450" width="940" height="78" as="geometry"/></mxCell><mxCell id="n26" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9673A6;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n21" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="&lt;span style='font-size:28px'&gt;✅&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:11px'&gt;LAYER 6  SCIENTIFIC VALIDATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="200" height="78" as="geometry"/></mxCell><mxCell id="n28" value="&lt;span style='font-size:18px'&gt;✅&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style='font-size:14px'&gt;Physical Plausibility  (duty cycle, depth, transit count)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Confidence Score  (0–1 weighted: SNR + consistency)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Verdict  (high_confidence / human_review / false_positive)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="274" y="540" width="940" height="78" as="geometry"/></mxCell><mxCell id="n29" style="edgeStyle=none;rounded=0;html=1;strokeColor=#82B366;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n24" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="&lt;span style='font-size:28px'&gt;📋&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:11px'&gt;LAYER 7  OUTPUT &amp;amp; PRESENTATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="200" height="78" as="geometry"/></mxCell><mxCell id="n31" value="&lt;span style='font-size:18px'&gt;📋&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style='font-size:14px'&gt;JSON Report  (parameters, classification, confidence)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;PNG Figure  (2×2: raw, detrended, BLS, folded)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6472'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Streamlit Dashboard  (metric cards, 5 tabs, export)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="274" y="630" width="940" height="78" as="geometry"/></mxCell><mxCell id="n32" style="edgeStyle=none;rounded=0;html=1;strokeColor=#82B366;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n27" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="✅  All 7 layers built &amp;amp; tested  ·  Live: Layers 1–7  ·  ML Enhancement (Phase 2): Mamba SSM on ISRO curated data planned for 30-hr finale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#7A5C00;fontStyle=0;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60" y="736" width="1154" height="50" as="geometry"/