<mxfile><diagram id="d1" name="d1"><mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="🧠  Deep Learning Architecture — Mamba SSM Encoder (Planned)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#16213E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450.0" y="14" width="700" height="38" as="geometry"/></mxCell><mxCell id="n12" value="Phase 2  ·  pending ISRO curated dataset  ·  replaces Random Forest in Layer 5" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#5A6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="450.0" y="48" width="700" height="20" as="geometry"/></mxCell><mxCell id="n13" value="PLANNED — 30-hour Finale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=11;fontColor=#7A5C00;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="700.0" y="74" width="200" height="28" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b style='font-size:14px'&gt;📥 Input&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Phase-folded light curve&lt;br&gt;(time, flux, flux_err)&lt;br&gt;BLS periodogram features&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#4C63E0;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="280" height="100" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b style='font-size:14px'&gt;📊 Feature Extraction&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Transit shape metrics&lt;br&gt;Noise statistics&lt;br&gt;Depth/duration/SNR&lt;br&gt;Period aliases&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#4A90D9;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="280" height="100" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b style='font-size:14px'&gt;⚙ Normalization&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;LayerNorm over sequence&lt;br&gt;Min-max scaling&lt;br&gt;Z-score standardization&lt;br&gt;Masked padding&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#FF6600;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="670" y="120" width="280" height="100" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b style='font-size:14px'&gt;🔗 Sequence Prep&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Fixed-length windows&lt;br&gt;Sliding window stride=1&lt;br&gt;Sequence length: 2048&lt;br&gt;Batch size: 64&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E6FF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="280" height="100" as="geometry"/></mxCell><mxCell id="n18" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#9673A6;strokeWidth=2;fontSize=1;fontColor=#16213E;fontStyle=0;align=center;verticalAlign=middle;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="100" y="280" width="1400" height="220" as="geometry"/></mxCell><mxCell id="n22" value="🔄  Bidirectional Mamba SSM Encoder" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#16213E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="286" width="400" height="24" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b style='font-size:14px'&gt;Forward SSM&lt;br&gt;Layer 1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Selective scan&lt;br&gt;Hidden dim: 512&lt;br&gt;State dim: 16&lt;br&gt;Activation: SiLU&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="120.0" y="320" width="330.0" height="120" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b style='font-size:14px'&gt;Forward SSM&lt;br&gt;Layer 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Selective scan&lt;br&gt;Hidden dim: 512&lt;br&gt;State dim: 16&lt;br&gt;Residual connect&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="470.0" y="320" width="330.0" height="120" as="geometry"/></mxCell><mxCell id="n25" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b style='font-size:14px'&gt;Backward SSM&lt;br&gt;Layer 1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Reverse sequence&lt;br&gt;Hidden dim: 512&lt;br&gt;State dim: 16&lt;br&gt;Activation: SiLU&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="820.0" y="320" width="330.0" height="120" as="geometry"/></mxCell><mxCell id="n27" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n24" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b style='font-size:14px'&gt;Backward SSM&lt;br&gt;Layer 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Reverse sequence&lt;br&gt;Hidden dim: 512&lt;br&gt;State dim: 16&lt;br&gt;Residual connect&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1170.0" y="320" width="330.0" height="120" as="geometry"/></mxCell><mxCell id="n29" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b style='font-size:14px'&gt;&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Concatenate forward + backward outputs  →  Sequence representation (batch, seq_len, 1024)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8FDE0;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#16213E;fontStyle=0;align=center;verticalAlign=center;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="120" y="454" width="1360" height="36" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b style='font-size:14px'&gt;MLP Layer 1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Linear 1024 → 512&lt;br&gt;ReLU + Dropout 0.3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E6FF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="360.0" y="550" width="280" height="110" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b style='font-size:14px'&gt;MLP Layer 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Linear 512 → 256&lt;br&gt;ReLU + Dropout 0.3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E6FF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="660.0" y="550" width="280" height="110" as="geometry"/></mxCell><mxCell id="n33" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b style='font-size:14px'&gt;MLP Layer 3&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Linear 256 → 128&lt;br&gt;ReLU + Dropout 0.3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E6FF;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="960.0" y="550" width="280" height="110" as="geometry"/></mxCell><mxCell id="n35" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n32" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b style='font-size:14px'&gt;🎯 Output (Softmax)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;6 classes:&lt;br&gt;planet_transit / EB / blend&lt;br&gt;starspot / noise / unknown&lt;br&gt;Confidence calibration&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1260.0" y="550" width="280" height="110" as="geometry"/></mxCell><mxCell id="n37" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n34" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b style='font-size:14px'&gt;📋 Training Config&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Loss: Cross-entropy&lt;br&gt;Optimizer: AdamW (lr=1e-4)&lt;br&gt;Batch size: 64&lt;br&gt;Epochs: 100 (early stop@10)&lt;br&gt;Gradient clipping: 1.0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E0;strokeColor=#D6B656;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="60.0" y="700" width="493.3333333333333" height="130" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b style='font-size:14px'&gt;📈 Data Augmentation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Noise injection (Gaussian)&lt;br&gt;Transit depth scaling&lt;br&gt;Period jitter / phase shift&lt;br&gt;Missing data masking&lt;br&gt;Class balancing (weighted sampler)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E0;strokeColor=#D6B656;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="573.3333333333333" y="700" width="493.3333333333333" height="130" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b style='font-size:14px'&gt;📊 Evaluation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6472'&gt;Accuracy, Precision, Recall, F1&lt;br&gt;Confusion matrix&lt;br&gt;ROC-AUC per class&lt;br&gt;Calibration plot (ECE)&lt;br&gt;k-fold cross-validation (5)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E0;strokeColor=#D6B656;strokeWidth=2;fontSize=15;fontColor=#16213E;fontStyle=1;align=left;verticalAlign=top;arcSize=12;shadow=1;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1086.6666666666665" y="700" width="493.3333333333333" height="130" as="geometry"/></mxCell><mxCell id="n41" style="edgeStyle=none;rounded=0;html=1;strokeColor=#8A93A3;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="n17" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" style="rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry