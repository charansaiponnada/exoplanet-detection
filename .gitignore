### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml

__pycache__/
*.pyc
*.pyo
exo/
.venv/
.env

# Generated output figures & JSON (can be regenerated)
output/*.png
output/*.json
output/*.drawio

# Large temp / inspiration images
piepline-*.png
pipeline.png

# Temp Office files
~$*

# ML model artifacts (can be retrained)
models/*.joblib

# OS files
Thumbs.db
.DS_Store

# ---------------------------------------------------------------------------
# Bulk science data: regenerate with scripts/download_kepler.py,
# scripts/download_tess.py and scripts/fetch_catalogs.sh rather than committing.
# ---------------------------------------------------------------------------
data/kepler/
data/tess_lc/
data/processed/
*.fits

# Catalogue snapshots are large and fetched from the NASA Exoplanet Archive
data/catalogs/*.csv

# Experiment artefacts
logs/
results/runs/
*.pt
*.npz
*.h5

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls

# Jupyter checkpoints
.ipynb_checkpoints/
paper/main.spl
paper/main.pdf
